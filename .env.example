# Sahaaya Care Environment Configuration
PORT=4003
PROJECT_ID=ai-builder-sql-copilot
GCP_PROJECT_ID=ai-builder-sql-copilot
GCS_REGION=asia-south1

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# JWT & Authentication Secret
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# Email Provider Configuration ('mock', 'smtp', 'sendgrid', 'resend')
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=notifications@sahaayacare.example.com

# Demo and Safety Controls
DEMO_MODE=true
ENABLE_AI_ASSISTANT=true
DEFAULT_GRACE_PERIOD_MINUTES=30
